{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "publisher-asset-marketplace",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "main": "worker/index.ts",
  "vars": {
    "PREVIEW_GC_DELETE_ENABLED": "false",
    "PREVIEW_GC_RETENTION_DAYS": "90",
    "PREVIEW_GC_CONFIRMATION_DAYS": "7",
    "D1_SEARCH_ANALYTICS_ENABLED": "false",
    "D1_EMBED_AGGREGATES_ENABLED": "false",
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "cache": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "publisher-asset-marketplace",
      "database_id": "93b3f1b1-a71e-4387-bbfc-64d237e9551d",
      "migrations_dir": "migrations",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "EMBED_ANALYTICS",
      "dataset": "citesupply_embed_usage",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PREVIEW_UPLOADS",
      "bucket_name": "publisher-asset-scan-previews",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "URL_SCAN_JOBS",
        "queue": "publisher-url-scan-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "publisher-url-scan-results",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "publisher-url-scan-results-dlq",
      },
    ],
  },
  "services": [
    {
      "binding": "URL_SCANNER",
      "service": "publisher-asset-url-scanner",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
