{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "publisher-asset-marketplace",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "cache": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "publisher-asset-marketplace",
      "database_id": "93b3f1b1-a71e-4387-bbfc-64d237e9551d",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
