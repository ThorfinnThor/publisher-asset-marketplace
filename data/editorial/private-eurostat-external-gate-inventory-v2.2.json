    "sql": "SELECT a.id, a.source_id, a.slug, a.external_id, a.status, a.asset_type, a.canonical_url, a.embed_url, a.preview_url, a.citation_text, a.attribution_name, a.attribution_url, a.attribution_terms, a.embed_origin, a.source_updated_at, a.last_checked_at, a.license_code, a.rights_status, a.rights_json, a.metadata_json, a.search_indexable, s.key AS source_key, s.name AS source_name, s.base_url AS source_base_url, s.policy_url AS source_policy_url, s.active AS source_active FROM assets a LEFT JOIN sources s ON s.id = a.source_id WHERE a.slug = ? AND a.status = 'published' AND a.rights_status IN ('safe', 'restricted') LIMIT 1",
