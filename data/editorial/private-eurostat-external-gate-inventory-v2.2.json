      "a.source_updated_at",
      "a.last_checked_at",
      "a.license_code",
      "a.rights_status",
      "a.rights_json",
      "a.metadata_json",
      "s.key",
      "s.name",
      "s.policy_url",
      "s.active"
    ],
    "acceptance": {
      "row_count": "exactly_one",
      "id": "non_empty_persistent_id",
      "slug": "must_equal_bound_slug",
      "external_id": "must_equal_expected_eurostat_dataset",
