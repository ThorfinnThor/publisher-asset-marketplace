    "execution_context": "Production D1 read-only query aligned with src/lib/assets/get-asset.ts and the assets/sources schema.",
    "sql": "SELECT a.id, a.source_id, a.slug, a.external_id, a.status, a.asset_type, a.canonical_url, a.embed_url, a.preview_url, a.citation_text, a.attribution_name, a.attribution_url, a.attribution_terms, a.embed_origin, a.source_updated_at, a.last_checked_at, a.license_code, a.rights_status, a.rights_json, a.metadata_json, a.search_indexable, s.key AS source_key, s.name AS source_name, s.base_url AS source_base_url, s.policy_url AS source_policy_url, s.active AS source_active FROM assets a LEFT JOIN sources s ON s.id = a.source_id WHERE a.slug = ? AND a.status = 'published' AND a.rights_status IN ('safe', 'restricted') LIMIT 1",
    "bind_parameter": "article_asset_slug",
    "required_columns": [
      "a.id",
      "a.source_id",
      "a.slug",
      "a.external_id",
      "a.status",
      "a.canonical_url",
      "a.embed_url",
      "a.preview_url",
      "a.citation_text",
      "a.attribution_name",
      "a.attribution_url",
      "a.attribution_terms",
      "a.embed_origin",
      "a.source_updated_at",
      "a.last_checked_at",
      "a.license_code",
      "a.rights_status",
      "a.rights_json",
      "a.metadata_json",
      "s.key",
      "s.name",
      "s.policy_url",
      "s.active"
    ],
    "acceptance": {
      "row_count": "exactly_one",
      "id": "non_empty_persistent_id",
      "slug": "must_equal_bound_slug",
      "external_id": "must_equal_expected_eurostat_dataset",
      "source_id": "must_equal_expected_source_id",
      "source_key": "eurostat",
      "source_active": 1,
      "status": "published",
      "rights_status_at_identity": ["safe", "restricted"],
      "canonical_url": "HTTPS and equal to expected_source_canonical_url",
      "source_policy_url": "HTTPS and equal to https://ec.europa.eu/eurostat/help/copyright-notice",
      "public_asset_url": "Derived Cite Supply /asset/<slug> URL must equal expected_public_asset_url and return HTTPS 200 independently of D1 canonical_url"
    },
    "schema_invariants": [
      "assets.slug is UNIQUE COLLATE NOCASE",
      "(source_id, external_id) is unique when external_id is not null"
    ],
    "fail_closed_if": [
      "zero or multiple rows, missing id, or non-published status",
      "dataset, source, source canonical URL, public asset URL, active flag, or policy URL mismatches",
      "a write-capable D1 query or an inference from the public asset page is used as a substitute for persisted identity"
    ]
