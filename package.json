{
  "name": "publisher-asset-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:scanner": "wrangler deploy --config wrangler.scanner.jsonc",
    "cf:typegen": "wrangler types --env-file .env.example",
    "cf:typegen:scanner": "wrangler types scanner-configuration.d.ts --config wrangler.scanner.jsonc --env-file /dev/null --env-interface ScannerEnvBindings --include-runtime false && prettier --write scanner-configuration.d.ts",
    "cf:typegen:check": "wrangler types --check --env-file .env.example && wrangler types scanner-configuration.d.ts --check --config wrangler.scanner.jsonc --env-file /dev/null --env-interface ScannerEnvBindings --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "ingest:dry-run": "tsx scripts/ingest-owid.ts data/seed/owid-first-10.csv",
    "ingest:fetch": "tsx scripts/fetch-owid.ts",
    "ingest:import": "tsx scripts/import-owid.ts",
    "ingest:corpus": "tsx scripts/import-owid-corpus.ts",
    "ingest:owid:catalog": "tsx scripts/fetch-owid-catalog.ts",
    "ingest:owid:missing": "tsx scripts/select-missing-owid-catalog.ts",
    "ingest:worldbank": "tsx scripts/import-worldbank.ts",
    "ingest:worldbank:catalog": "tsx scripts/import-worldbank-catalog.ts",
    "ingest:eurostat": "tsx scripts/import-eurostat.ts",
    "ingest:eurostat:catalog": "tsx scripts/import-eurostat-catalog.ts",
    "verify:eurostat:catalog": "tsx scripts/verify-eurostat-catalog.ts",
    "audit:import": "tsx scripts/audit-import.ts",
    "refresh:assets": "tsx scripts/refresh-assets.ts",
    "rights:review": "tsx scripts/review-rights.ts",
    "rights:owid-corpus": "tsx scripts/review-owid-corpus-rights.ts",
    "reconcile:owid-pending": "tsx scripts/reconcile-owid-pending.ts",
    "rights:worldbank-catalog": "tsx scripts/review-worldbank-catalog-rights.ts",
    "search:review": "tsx scripts/review-search-quality.ts --output docs/search-quality-review-c8.md",
    "editorial:fact-packs": "tsx scripts/editorial/build-fact-packs.ts",
    "editorial:analysis": "tsx scripts/editorial/build-analyses.ts",
    "editorial:drafts:check": "tsx scripts/editorial/validate-drafts.ts",
    "release:smoke": "tsx scripts/release-smoke.ts",
    "audit:production": "tsx scripts/audit-production.ts",
    "e2e:submission": "tsx scripts/e2e-submission.ts",
    "e2e:submission-accessibility": "tsx scripts/e2e-submission-accessibility.ts",
    "e2e:url-scan-conversion": "tsx scripts/e2e-url-scan-conversion.ts",
    "e2e:embed-sandbox": "tsx scripts/e2e-embed-sandbox.ts",
    "lint": "eslint src scripts test worker scanner",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "check": "npm run cf:typegen:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/vite-plugin": "1.54.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
